# SwanLab Self-Hosted（docker-next）配置
# 由 install.sh 生成到运行目录；修改后 `docker compose up -d` 生效
# 留空的外接变量 = 使用 compose 内嵌的本机默认值

# ---- 公共 ----
# 固定 compose 项目名，避免不同执行路径导致容器与卷前缀漂移
COMPOSE_PROJECT_NAME=swanlab
# 应用版本：VERSION env 用原值；镜像 tag 自动加 v 前缀（v3.4.0，对齐 chart helper）
SWANLAB_VERSION=3.4.0
# 对外暴露端口（gateway web 入口）
EXPOSE_PORT=8000
# 数据目录（相对运行目录，或绝对路径）
DATA_PATH=./data
# docker socket 路径（install.sh 自动探测写入；rootless / OrbStack 环境不同）
DOCKER_SOCKET_PATH=/var/run/docker.sock
# 对外域名（留空 = 不启用）
PUBLIC_HOST=
# 单次拷贝最大指标/图表数
MAX_METRICS_PER_COPY=20000
# 数据层 profile：本机部署四件套；外接某项即从列表移除（如外接 pg + 本机其余 = redis,clickhouse,minio）
COMPOSE_PROFILES=postgres,redis,clickhouse,minio

# ---- 业务副本数（默认对齐 k8s chart；单机内存紧张可降为 1）----
SERVER_REPLICAS=2
AUTH_REPLICAS=2
HOUSE_REPLICAS=2
NEXT_REPLICAS=2
CLOUD_REPLICAS=1

# ---- S3 模式（枚举 local|remote，脚本写入；remote = 外接对象存储）----
SS_STORAGE_TYPE=local

# ---- 数据层凭据（本机激活时 install.sh 随机生成；外接时填写外部凭据）----
POSTGRES_PASSWORD=
CLICKHOUSE_PASSWORD=
MINIO_ROOT_PASSWORD=

# ---- 外接配置（留空 = 本机默认；外接某项 = 从 COMPOSE_PROFILES 移除并填写）----
# PostgreSQL 连接串（外接必填；REPLICA 留空时副本串沿用主库串语义）
DATABASE_URL=
DATABASE_URL_REPLICA=
# Redis 连接串（外接必填）
REDIS_URL=
# ClickHouse（外接必填 HOST / USER / PASSWORD）
CLICKHOUSE_HOST=
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_TCP_PORT=9000
CLICKHOUSE_DATABASE=app
CLICKHOUSE_USER=
# S3 对象存储（SS_STORAGE_TYPE=remote 时必填 ENDPOINT / REGION / DOMAIN / ACCESS_KEY / SECRET_KEY，
#   对齐 chart required 语义；PORT / USE_SSL 按实际存储填写，云 S3 通常 443 / true；桶需预先创建）
S3_PUBLIC_ENDPOINT=
S3_PUBLIC_REGION=
S3_PUBLIC_PORT=9000
S3_PUBLIC_USE_SSL=false
S3_PUBLIC_PATH_STYLE=true
S3_PUBLIC_BUCKET=swanlab-public
S3_PUBLIC_DOMAIN=
S3_PRIVATE_ENDPOINT=
S3_PRIVATE_REGION=
S3_PRIVATE_PORT=9000
S3_PRIVATE_USE_SSL=false
S3_PRIVATE_PATH_STYLE=true
S3_PRIVATE_BUCKET=swanlab-private
S3_ACCESS_KEY=
S3_SECRET_KEY=

# ---- 镜像仓库前缀（私有 Harbor / 离线场景可改）----
REGISTRY_PREFIX=repo.swanlab.cn
